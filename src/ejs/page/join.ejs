<!DOCTYPE html>
<html lang="ja">
    <%- include("../general/_head" , {data: dataJSON["join"]}) %>
<body>
    <%- include("../layout/_header") -%>
	<%- include("../layout/_globalNav") -%>

    <main>

		<div class="breadcrumb">
			<a href="/">HOME</a><a href="/join/index.html" class="currentpage">新規加入をご検討のお客様</a>
		</div>
		<div class="main_inner page_link">
			<h1>新規加入をご検討のお客様</h1>

			<!--▽イントロセクション-->
			<section id="join_intro" class="joinIntroSection">
				<div class="section_inner">
					<div class="joinIntroBoxes">
						<div class="joinIntroBox joinIntroBox--left">
							<p class="joinIntroBox__label">独自の光回線インターネット！</p>
							<p class="joinIntroBox__main"><strong>工事1週間で</strong><br>Wi-Fi環境が整います！</p>
						</div>
						<p class="joinIntroSakurai">さらに</p>
						<div class="joinIntroBox joinIntroBox--right">
							<p class="joinIntroBox__course">ネット2Gコースなら6年間</p>
							<p class="joinIntroBox__price">月額<span class="joinIntroBox__nanto">なんと</span><span class="joinIntroBox__num">880</span><span class="joinIntroBox__en">円<small>税込</small></span></p>
						</div>
					</div>
					<p class="joinIntroSub">その他にも家計にやさしいおトクなプランを取り揃えています。</p>
					<a class="joinIntroReasonBtn" href="#select_reason">
						<span class="joinIntroReasonBtn__stars">★★★★★</span>
						スターキャットが選ばれる<span class="joinIntroReasonBtn__num">5</span>つの理由
					</a>
				</div>
			</section>

			<!--▽スターキャットのサービス-->
			<section id="about_service" class="joinServiceSection">
				<div class="section_inner">
					<h2 class="joinSectionTitle">スターキャットのサービス</h2>
					<p class="joinSectionLead">スターキャットがお客様にあったプランをご提案いたします！</p>
					<p class="joinSectionLead2">スターキャットでは、「インターネット」「テレビ」「固定電話」をはじめ、携帯サービスや割引サービスをご用意しております。</p>

					<!--▽住宅タイプタブ-->
					<div class="joinHouseTab">
						<button class="joinHouseTab__btn joinHouseTab__btn--kodate joinHouseTab__btn--active" data-tab="kodate">
							<img src="/img/icon/kodate_icon.svg" alt="">
							<span>戸建住宅のお客様へ</span>
						</button>
						<button class="joinHouseTab__btn joinHouseTab__btn--apmh" data-tab="apmh">
							<img src="/img/icon/apmh_icon.svg" alt="">
							<span>集合住宅のお客様へ</span>
						</button>
					</div>

					<!--▽サービスボックス(戸建住宅)-->
					<div class="joinServiceBox joinServiceBox--active" data-tabpanel="kodate">
						<div class="joinServiceIcons">
							<a href="/service/net/" class="joinServiceIcon">
								<img src="/img/icon/starcat_net_icon.svg" alt="インターネット">
								<p>インターネット</p>
							</a>
							<a href="/service/tv/" class="joinServiceIcon">
								<img src="/img/icon/starcat_tv_icon.svg" alt="テレビ">
								<p>テレビ</p>
							</a>
							<a href="/service/tel/" class="joinServiceIcon">
								<img src="/img/icon/starcat_tel_icon.svg" alt="電話">
								<p>電話</p>
							</a>
						</div>
						<div class="joinServiceQuickLinks">
							<a href="/simulation/" class="joinServiceQuickLink">
								<img src="/img/icon/price_simulation_icon.svg" alt="">料金シミュレーション
							</a>
							<a href="/campaign/" class="joinServiceQuickLink">
								<img src="/img/icon/campaign_orange_icon.svg" alt="">キャンペーン・特典
							</a>
							<a href="/service_area/" class="joinServiceQuickLink">
								<img src="/img/icon/apmh_search_icon.svg" alt="">サービス提供エリア
							</a>
						</div>
						<p class="joinServiceBoxLead">お客様にあったプランをご提案いたしますので、お気軽にお問い合わせください。</p>
						<div class="joinServiceBtns">
							<a href="/mform/?ref=main_content_footer" class="joinServiceBtn joinServiceBtn--apply">新規加入お申し込み</a>
							<a href="/mform_inquiry/?ref=main_content_footer" class="joinServiceBtn joinServiceBtn--inquiry">お問い合わせ</a>
							<a href="/faq/" class="joinServiceBtn joinServiceBtn--faq">よくあるご質問</a>
						</div>
						<a href="/join/house/" class="joinServiceTopLink">戸建住宅のお客様TOP &gt;</a>
					</div>

					<!--▽サービスボックス(集合住宅)-->
					<div class="joinServiceBox" data-tabpanel="apmh">
						<div class="joinServiceIcons">
							<a href="/service/net/" class="joinServiceIcon">
								<img src="/img/icon/starcat_net_icon.svg" alt="インターネット">
								<p>インターネット</p>
							</a>
							<a href="/service/tv/" class="joinServiceIcon">
								<img src="/img/icon/starcat_tv_icon.svg" alt="テレビ">
								<p>テレビ</p>
							</a>
							<a href="/service/tel/" class="joinServiceIcon">
								<img src="/img/icon/starcat_tel_icon.svg" alt="電話">
								<p>電話</p>
							</a>
						</div>
						<div class="joinServiceQuickLinks">
							<a href="/simulation/" class="joinServiceQuickLink">
								<img src="/img/icon/price_simulation_icon.svg" alt="">料金シミュレーション
							</a>
							<a href="/campaign/" class="joinServiceQuickLink">
								<img src="/img/icon/campaign_orange_icon.svg" alt="">キャンペーン・特典
							</a>
							<a href="/service_area/" class="joinServiceQuickLink">
								<img src="/img/icon/apmh_search_icon.svg" alt="">サービス提供エリア
							</a>
						</div>
						<p class="joinServiceBoxLead">お客様にあったプランをご提案いたしますので、お気軽にお問い合わせください。</p>
						<div class="joinServiceBtns">
							<a href="/mform/?ref=main_content_footer" class="joinServiceBtn joinServiceBtn--apply">新規加入お申し込み</a>
							<a href="/mform_inquiry/?ref=main_content_footer" class="joinServiceBtn joinServiceBtn--inquiry">お問い合わせ</a>
							<a href="/faq/" class="joinServiceBtn joinServiceBtn--faq">よくあるご質問</a>
						</div>
						<a href="/join/apartment/" class="joinServiceTopLink">集合住宅のお客様TOP &gt;</a>
					</div>
				</div>
			</section>

			<!--▽その他のサービス-->
			<section id="other_service" class="joinOtherSection">
				<div class="section_inner">
					<h2 class="joinSectionTitle">その他のサービス</h2>
					<ul class="joinOtherList">
						<li>
							<a href="/service/other/#discount" class="joinOtherItem">
								<img src="/img/icon/service_discount_icon.svg" alt="携帯・割引サービス">
								<div class="joinOtherItem__body">
									<p class="joinOtherItem__title">携帯・割引サービス</p>
									<p class="joinOtherItem__desc">スターキャットのサービスとセットでご利用いただくことでおトクになる各種サービスもご案内中です。</p>
								</div>
								<span class="joinOtherItem__arrow">&gt;</span>
							</a>
						</li>
						<li>
							<a href="/service/mvno/" class="joinOtherItem">
								<img src="/img/icon/service_smartPhone.svg" alt="格安スマホサービス">
								<div class="joinOtherItem__body">
									<p class="joinOtherItem__title">格安スマホサービス</p>
									<p class="joinOtherItem__desc">ご自宅でも訪問でもお申し込みができるスターキャットの格安スマホ「ケーブルスマホ」のご案内です。</p>
								</div>
								<span class="joinOtherItem__arrow">&gt;</span>
							</a>
						</li>
						<li>
							<a href="/service/vod/" class="joinOtherItem">
								<img src="/img/icon/service_video-delivery.svg" alt="動画配信サービス">
								<div class="joinOtherItem__body">
									<p class="joinOtherItem__title">動画配信サービス</p>
									<p class="joinOtherItem__desc">テレビ、スマホ、タブレット、パソコンなどで観たいときに、見たい場所で映画、ドラマ、アニメ、スポーツなどを楽しめるサービスです。</p>
								</div>
								<span class="joinOtherItem__arrow">&gt;</span>
							</a>
						</li>
						<li>
							<a href="/service/net/option/security-camera/" class="joinOtherItem">
								<img src="/img/icon/service_security-camera.svg" alt="防犯カメラサービス">
								<div class="joinOtherItem__body">
									<p class="joinOtherItem__title">防犯カメラサービス</p>
									<p class="joinOtherItem__desc">家族見守りカメラなら、24時間あなたの代わりに家を見守り、外出先からスマホで確認できます。見えない不安を安心に。自分の暮らしをもっと安全・安心に。</p>
								</div>
								<span class="joinOtherItem__arrow">&gt;</span>
							</a>
						</li>
						<li>
							<a href="/service/other/" class="joinOtherItem">
								<img src="/img/icon/service_emergency-report.svg" alt="生活向上サービス">
								<div class="joinOtherItem__body">
									<p class="joinOtherItem__title">生活向上サービス</p>
									<p class="joinOtherItem__desc">もしものときに備えておきたい！お住まいの地域の防災に関する情報をお提供する安心サービスをご用意しています。</p>
								</div>
								<span class="joinOtherItem__arrow">&gt;</span>
							</a>
						</li>
					</ul>
				</div>
			</section>

			<!--▽法人のお客様-->
			<section class="joinCorporateSection">
				<div class="section_inner">
					<p class="joinCorporateLead">法人のお客様・マンションオーナー様・管理会社へ</p>
					<p class="joinCorporateSub">オフィスや建物へのご導入はstarcat Bizにおまかせください！</p>
					<div class="cp_banner banner">
						<a href="/business/" target="_blank">
							<div class="banner_inner">
								<div class="image">
									<img src="/img/business/service01-net_pic.jpg" alt="">
								</div>
								<div class="text">
									<p class="title">法人のお客様向け「starcat Biz」</p>
									<p>スターキャット品質でみなさまのビジネスをサポートします。</p>
								</div>
							</div>
						</a>
					</div>
				</div>
			</section>

			<!--▽お問い合わせセクション-->
			<section>
				<div class="section_inner">
					<div class="join_menu">
						<div class="contact_block flex">
							<div class="apply_area">
								<p class="apply_area__badge">カンタン<span>3</span>分</p>
								<p class="apply_area__label">Webからお申し込み</p>
								<a class="apply_btn flex flex_align_center flex_justify_center" href="/mform/?ref=main_content_footer"><span>新規お申し込み</span></a>
							</div>
							<div class="contact_block_inner">
								<p class="title_border">新規加入に関するお問い合わせ</p>
								<div class="contact_link_list flex flex_justify_center">
									<a class="contact_link_btn form" href="/mform_inquiry/?ref=main_content_footer"><span>フォームから<br>お問い合わせ</span></a>
									<a class="contact_link_btn online" href="https://reserva.be/starcat" target="_blank" rel="noopener noreferrer"><span>オンライン<br>加入相談</span></a>
									<a class="contact_link_btn chat" href="javascript:synalio.toggle(0);"><span>チャットで<br>お問い合わせ</span></a>
									<a id="header_tablet_freecall" class="contact_link_btn tel" href="tel:0120-181-374"><span>お電話で<br>お問い合わせ</span></a>
								</div>
								<div class="tel_contact flex flex_align_center">
									<p>お電話でお問い合わせ</p>
									<div class="freecall">
										<div class="tel">
											<img src="/img/icon/freecall.svg">
											<a href="tel:0120-181-374">0120-181-374</a>
										</div>
										<p>受付時間：日・祝除く9:00～18:00</p>
									</div>
								</div>
							</div>
						</div>
						<div class="menu_block flex">
							<a class="apmh_search flex flex_align_center" href="/service_area/msearch/?ref=main_content_footer">
								<p><span>お住まいの建物の対応状況を確認</span>スターキャット対応マンション・アパート検索</p>
							</a>
							<a class="price_simulation flex flex_align_center" href="/simulation/?ref=main_content_footer">
								<p>料金シミュレーション</p>
							</a>
						</div>
					</div>
				</div>
			</section>
		</div>
		<ul class="main_navi">
			<li><a href="/">HOME<img src="/img/icon/link_icon.svg" class="sp"></a></li>
			<li><a href="/service/">スターキャットのサービス<img src="/img/icon/link_icon.svg" class="sp"></a></li>
			<li><a href="/campaign/">キャンペーン<img src="/img/icon/link_icon.svg" class="sp"></a></li>
		</ul>

	<script>
	(function () {
		var tabs = document.querySelectorAll('.joinHouseTab__btn[data-tab]');
		var panels = document.querySelectorAll('.joinServiceBox[data-tabpanel]');
		tabs.forEach(function (btn) {
			btn.addEventListener('click', function () {
				var target = this.dataset.tab;
				tabs.forEach(function (b) { b.classList.remove('joinHouseTab__btn--active'); });
				panels.forEach(function (p) { p.classList.remove('joinServiceBox--active'); });
				this.classList.add('joinHouseTab__btn--active');
				document.querySelector('.joinServiceBox[data-tabpanel="' + target + '"]').classList.add('joinServiceBox--active');
			});
		});
	}());
	</script>
    </main>

	<%- include("../layout/_footContentArea") %>
    <%- include("../layout/_footer") %>
</body>
</html>

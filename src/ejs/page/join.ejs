<!DOCTYPE html>
<html lang="ja">
    <%- include("../general/_head" , {data: dataJSON["join"]}) %>
<body>
    <%- include("../layout/_header") -%>
	<%- include("../layout/_globalNav") -%>

    <main>

		<div class="breadcrumb">
			<a href="/">HOME</a><a href="/join/index.html" class="currentpage">新規加入をご検討のお客様</a>
		</div>
		<div class="main_inner page_link">
			<h1>新規加入をご検討のお客様</h1>

			<!--▽イントロセクション-->
			<section id="join_intro" class="joinIntroSection">
				<div class="section_inner">
					<div class="joinIntroContent">
						<p class="joinIntroLead">独自の光回線インターネット！</p>
						<div class="joinIntroHighlight">
							<p class="joinIntroHighlight__text"><strong>1工事1週間で</strong><br>Wi-Fi環境が整います！</p>
							<p class="joinIntroHighlight__more"><a href="/service/net/">さらに ></a></p>
						</div>
						<div class="joinIntroPricing">
							<p class="joinIntroPricing__label">ネット2Gコースなら6年間</p>
							<p class="joinIntroPricing__price">月額<span class="joinIntroPricing__num">880</span>円</p>
						</div>
						<p class="joinIntroSub">その他にも家計にやさしいおトクなプラン<br>をご用意しています</p>
						<a class="joinIntroReasonBtn" href="#select_reason">
							スターキャットが選ばれる<span class="joinIntroReasonBtn__num">5</span>つの理由
						</a>
					</div>
				</div>
			</section>

			<!--▽スターキャットのサービス-->
			<section id="about_service" class="joinServiceSection">
				<div class="section_inner">
					<h2 class="joinSectionTitle">スターキャットのサービス</h2>
					<p class="joinSectionLead">スターキャットがお客様にあったプランをご提案いたします！</p>

					<!--▽住宅タイプタブ-->
					<div class="joinHouseTab">
						<a class="joinHouseTab__btn joinHouseTab__btn--kodate" href="/join/house/">
							<img src="/img/icon/kodate_icon.svg" alt="戸建住宅アイコン">
							<p>戸建住宅のお客様</p>
						</a>
						<a class="joinHouseTab__btn joinHouseTab__btn--apmh" href="/join/apartment/">
							<img src="/img/icon/apmh_icon.svg" alt="集合住宅アイコン">
							<p>集合住宅のお客様</p>
						</a>
					</div>

					<!--▽サービスカード-->
					<div class="joinServiceCards">
						<div class="joinServiceCard">
							<a href="/service/net/">
								<div class="joinServiceCard__header">
									<img src="/img/service/service_list_pic_01.jpg" alt="インターネット">
								</div>
								<div class="joinServiceCard__body">
									<p class="joinServiceCard__title">インターネット</p>
									<p class="joinServiceCard__desc">下り最大10Gbpsの超高速回線で動画視聴やオンライン会議も快適！</p>
								</div>
							</a>
							<ul class="joinServiceCard__links">
								<li><a href="/simulation/">料金シミュレーション</a></li>
								<li><a href="/campaign/">キャンペーン・ご優待のご紹介</a></li>
								<li><a href="/service/net/#_link_2">サービス詳細・ご利用料金</a></li>
							</ul>
						</div>
						<div class="joinServiceCard">
							<a href="/service/tv/">
								<div class="joinServiceCard__header">
									<img src="/img/service/service_list_pic_04.jpg" alt="テレビ">
								</div>
								<div class="joinServiceCard__body">
									<p class="joinServiceCard__title">テレビ</p>
									<p class="joinServiceCard__desc">アンテナ不要！地上波・BS・4K対応。最大58chの専門チャンネル！</p>
								</div>
							</a>
							<ul class="joinServiceCard__links">
								<li><a href="/simulation/">料金シミュレーション</a></li>
								<li><a href="/campaign/">キャンペーン・ご優待のご紹介</a></li>
								<li><a href="/service/tv/#_link_2">サービス詳細・ご利用料金</a></li>
							</ul>
						</div>
						<div class="joinServiceCard">
							<a href="/service/tel/">
								<div class="joinServiceCard__header">
									<img src="/img/service/service_list_pic_05.jpg" alt="電話">
								</div>
								<div class="joinServiceCard__body">
									<p class="joinServiceCard__title">電話</p>
									<p class="joinServiceCard__desc">基本料・通話料がおトク！電話番号もそのまま使える！</p>
								</div>
							</a>
							<ul class="joinServiceCard__links">
								<li><a href="/simulation/">料金シミュレーション</a></li>
								<li><a href="/service/tel/#_link_2">サービス詳細・ご利用料金</a></li>
							</ul>
						</div>
					</div>

					<div class="joinServiceBottomLinks">
						<a class="joinServiceBottomLink" href="/simulation/">
							<img src="/img/icon/price_simulation_icon.svg" alt="料金シミュレーション">
							<span>料金シミュレーション</span>
						</a>
						<a class="joinServiceBottomLink" href="/campaign/">
							<img src="/img/icon/campaign_w_icon.svg" alt="キャンペーン">
							<span>キャンペーン</span>
						</a>
					</div>

					<div class="joinHouseLinks">
						<a href="/join/house/" class="joinHouseLink">戸建住宅のお客様はこちら ></a>
						<a href="/join/apartment/" class="joinHouseLink">集合住宅のお客様はこちら ></a>
					</div>
				</div>
			</section>

			<!--▽その他のサービス-->
			<section id="other_service" class="joinOtherSection">
				<div class="section_inner">
					<h2 class="joinSectionTitle">その他のサービス</h2>
					<div class="joinOtherGrid">
						<a href="/service/mvno/" class="joinOtherItem">
							<img src="/img/icon/service_smartPhone.svg" alt="ケーブルスマホ">
							<p>携帯・割引サービス</p>
						</a>
						<a href="/service/vod/" class="joinOtherItem">
							<img src="/img/icon/service_video-delivery.svg" alt="動画配信サービス">
							<p>動画配信サービス</p>
						</a>
						<a href="/service/net/option/security-camera/" class="joinOtherItem">
							<img src="/img/icon/service_security-camera.svg" alt="防犯カメラ">
							<p>防犯カメラサービス 24時間セキュリティ</p>
						</a>
						<a href="/service/net/option/omakase-wifi/" class="joinOtherItem">
							<img src="/img/logo/omakase_wifi.png" alt="おまかせWi-Fi">
							<p>おまかせWi-Fiサービス</p>
						</a>
						<a href="/service/other/" class="joinOtherItem">
							<img src="/img/icon/service_emergency-report.svg" alt="生活向上サービス">
							<p>生活向上サービス</p>
						</a>
					</div>
				</div>
			</section>

			<!--▽法人のお客様-->
			<section class="joinCorporateSection">
				<div class="section_inner">
					<p class="joinCorporateLead">法人のお客様・マンションオーナー様・管理会社へ</p>
					<p class="joinCorporateSub">オフィスや建物へのご導入はstarcat Bizにおまかせください！</p>
					<div class="cp_banner banner">
						<a href="/business/" target="_blank">
							<div class="banner_inner">
								<div class="image">
									<img src="/img/business/service01-net_pic.jpg" alt="">
								</div>
								<div class="text">
									<p class="title">法人のお客様向け「starcat Biz」</p>
									<p>スターキャット品質でみなさまのビジネスをサポートします。</p>
								</div>
							</div>
						</a>
					</div>
				</div>
			</section>

			<!--▽お問い合わせセクション-->
			<section>
				<div class="section_inner">
					<div class="join_menu">
						<div class="contact_block flex">
							<a class="apply_btn flex flex_align_center flex_justify_center" href="/mform/?ref=main_content_footer"><span>新規お申し込み</span></a>
							<div class="contact_block_inner">
								<p class="title_border">新規加入に関するお問い合わせ</p>
								<div class="contact_link_list flex flex_justify_center">
									<a class="contact_link_btn form" href="/mform_inquiry/?ref=main_content_footer"><span>フォームから<br>お問い合わせ</span></a>
									<a class="contact_link_btn online" href="https://reserva.be/starcat" target="_blank" rel="noopener noreferrer"><span>オンライン<br>加入相談</span></a>
									<a class="contact_link_btn chat" href="javascript:synalio.toggle(0);"><span>チャットで<br>お問い合わせ</span></a>
									<a id="header_tablet_freecall" class="contact_link_btn tel" href="tel:0120-181-374"><span>お電話で<br>お問い合わせ</span></a>
								</div>
								<div class="tel_contact flex flex_align_center">
									<p>お電話でお問い合わせ</p>
									<div class="freecall">
										<div class="tel">
											<img src="/img/icon/freecall.svg">
											<a href="tel:0120-181-374">0120-181-374</a>
										</div>
										<p>受付時間：日・祝除く9:00～18:00</p>
									</div>
								</div>
							</div>
						</div>
						<div class="menu_block flex">
							<a class="apmh_search flex flex_align_center" href="/service_area/msearch/?ref=main_content_footer">
								<p><span>お住まいの建物の対応状況を確認</span>スターキャット対応マンション・アパート検索</p>
							</a>
							<a class="price_simulation flex flex_align_center" href="/simulation/?ref=main_content_footer">
								<p>料金シミュレーション</p>
							</a>
						</div>
					</div>
				</div>
			</section>
		</div>
		<ul class="main_navi">
			<li><a href="/">HOME<img src="/img/icon/link_icon.svg" class="sp"></a></li>
			<li><a href="/service/">スターキャットのサービス<img src="/img/icon/link_icon.svg" class="sp"></a></li>
			<li><a href="/campaign/">キャンペーン<img src="/img/icon/link_icon.svg" class="sp"></a></li>
		</ul>

    </main>

	<%- include("../layout/_footContentArea") %>
    <%- include("../layout/_footer") %>
</body>
</html>
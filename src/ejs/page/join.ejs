<!DOCTYPE html>
<html lang="ja">
    <%- include("../general/_head" , {data: dataJSON["join"]}) %>
<body>
    <%- include("../layout/_header") -%>
	<%- include("../layout/_globalNav") -%>

    <main>

		<div class="breadcrumb">
			<a href="/">HOME</a><a href="/join/index.html" class="currentpage">新規加入をご検討のお客様</a>
		</div>
		<div class="main_inner page_link">
			<h1>新規加入をご検討のお客様</h1>

			<!--▽202603改修ここから-->
			<!--▽イントロセクション-->
			<section id="join_intro" class="joinIntroSection">
				<div class="section_inner">
					<div class="joinIntroBoxes">
						<div class="joinIntroBox joinIntroBox--left">
							<picture>
								<source media="(max-width: 500px)" srcset="/img/join/join_internet-install_sp.png">
								<img src="/img/join/join_internet-install_pc.png" alt="独自の光回線インターネット！工事1週間でWi-Fi環境が整います！">
							</picture>
						</div>
						<p class="joinIntroSakurai">さらに</p>
						<div class="joinIntroBox joinIntroBox--right">
							<picture>
								<source media="(max-width: 500px)" srcset="/img/join/join_internet-price_sp.png">
								<img src="/img/join/join_internet-price_pc.png" alt="ネット2Gコースなら6年間、月額なんと税込880円">
							</picture>
						</div>
					</div>
					<p class="joinIntroSub">その他にも家計にやさしいおトクなプランを取り揃えています。</p>
					<a href="/join/benefit/?ref=join_kodate" class="bottomArrowLinkButton_fill" aria-label="スターキャットが選ばれる5つの理由">
						<img src="/img/common/5star.svg" alt="5つ星">
						<span class="fontSizeS">スターキャットが選ばれる</span><br class="showTB">
						<span class="colorYellow"><span class="fontSizeXXXL">5</span>つ</span>の理由
					</a>
				</div>
			</section>

			<!--▽スターキャットのサービス-->
			<section id="about_service" class="joinServiceSection">
				<div class="section_inner">
					<h2 class="sectionTitle">スターキャットのサービス</h2>
					<p class="joinSectionLead">スターキャットがお客様にあったプランをご提案いたします！</p>
					<p class="joinSectionLead2">スターキャットでは、「インターネット」「テレビ」「固定電話」をはじめ、携帯サービスや割引サービスをご用意しております。</p>

					<!--▽住宅タイプタブ-->
					<div class="joinHouseTab">
						<button id="tab_kodate" class="joinHouseTab__btn joinHouseTab__btn--kodate active" onclick="switchTab(tabpanel_kodate)">
							<img src="/img/icon/kodate_icon.svg" alt="">
							<span>戸建住宅の<br class="showTB">お客様へ</span>
						</button>
						<button id="tab_apmh" class="joinHouseTab__btn joinHouseTab__btn--apmh" onclick="switchTab(tabpanel_apmh)">
							<img src="/img/icon/apmh_icon.svg" alt="">
							<span>集合住宅の<br class="showTB">お客様へ</span>
						</button>
					</div>

					<!--▽サービスボックス(戸建住宅)-->
					<div id="tabpanel_kodate" class="joinServiceBox active">
						<div class="joinServiceBox__inner">
							<div class="joinServiceIcons">
								<a href="/service/net/course-kodate/?ref=join_kodate" class="joinServiceIcon">
									<img src="/img/icon/starcat_net_icon.svg" alt="インターネット">
									<p>インターネット</p>
								</a>
								<a href="/service/tv/course-kodate/?ref=join_kodate" class="joinServiceIcon">
									<img src="/img/icon/starcat_tv_icon.svg" alt="テレビ">
									<p>テレビ</p>
								</a>
								<a href="/service/tel/?ref=join_kodate" class="joinServiceIcon">
									<img src="/img/icon/starcat_tel_icon.svg" alt="電話">
									<p>電話</p>
								</a>
							</div>
							<div class="joinServiceQuickLinks">
								<a href="/simulation/area/kodate/?ref=join_kodate" class="joinServiceQuickLink">
									<img src="/img/icon/price_simulation_icon.svg" alt="料金シミュレーションアイコン">料金シミュレーション
								</a>
								<a href="/campaign/?ref=join_kodate" class="joinServiceQuickLink">
									<img src="/img/icon/campaign_orange_icon.svg" alt="キャンペーン・特典アイコン">キャンペーン・特典
								</a>
								<a href="/service_area/?ref=join_kodate" class="joinServiceQuickLink">
									<img src="/img/icon/servicearea_white_icon.svg" alt="エリアアイコン">サービス提供エリア
								</a>
							</div>
							<p class="joinServiceBoxLead">お客様にあったプランをご提案いたしますので、お気軽にお問い合わせください。</p>
							<ul class="joinServiceBtns">
								<li><a href="/mform/?ref=join_kodate" class="joinServiceBtn joinServiceBtn--apply icon_before" data-icon="entry">新規加入お申し込み</a></li>
								<li>
									<a href="/contact/?ref=join_kodate#_link_1" class="joinServiceBtn joinServiceBtn--inquiry icon_before" data-icon="inquiry">
										<p>お問い合わせ</p>
									</a>
								</li>
								<li><a href="https://faq.starcat.co.jp/?ref=join_kodate" class="joinServiceBtn joinServiceBtn--faq icon_before" data-icon="faq_outline">よくあるご質問</a></li>
							</ul>
						</div>
						<a href="/join/house/?ref=join_kodate" class="joinServiceTopLink icon_after" data-icon="arrow_next">戸建住宅のお客様TOP</a>
					</div>

					<!--▽サービスボックス(集合住宅)-->
					<div id="tabpanel_apmh" class="joinServiceBox">
						<div class="joinServiceBox__inner">
							<div class="joinServiceIcons">
								<a href="/service/net/course-apmh/?ref=join_apmh" class="joinServiceIcon">
									<img src="/img/icon/starcat_net_icon.svg" alt="インターネット">
									<p>インターネット</p>
								</a>
								<a href="/service/tv/course-apmh/?ref=join_apmh" class="joinServiceIcon">
									<img src="/img/icon/starcat_tv_icon.svg" alt="テレビ">
									<p>テレビ</p>
								</a>
								<a href="/service/tel/?ref=join_apmh" class="joinServiceIcon">
									<img src="/img/icon/starcat_tel_icon.svg" alt="電話">
									<p>電話</p>
								</a>
							</div>
							<div class="joinServiceQuickLinks">
								<a href="/simulation/area/apmh/?ref=join_apmh" class="joinServiceQuickLink">
									<img src="/img/icon/price_simulation_icon.svg" alt="料金シミュレーションアイコン">料金シミュレーション
								</a>
								<a href="/campaign/?ref=join_apmh" class="joinServiceQuickLink">
									<img src="/img/icon/campaign_orange_icon.svg" alt="キャンペーン・特典アイコン">キャンペーン・特典
								</a>
								<a href="/service_area/?ref=join_apmh" class="joinServiceQuickLink">
									<img src="/img/icon/servicearea_white_icon.svg" alt="エリアアイコン">サービス提供エリア
								</a>
							</div>
							<p class="joinServiceBoxLead">お客様にあったプランをご提案いたしますので、お気軽にお問い合わせください。</p>
							<ul class="joinServiceBtns">
								<li><a href="/mform/?ref=join_apmh" class="joinServiceBtn joinServiceBtn--apply icon_before" data-icon="entry">新規加入お申し込み</a></li>
								<li>
									<a href="/contact/?ref=join_apmh" class="joinServiceBtn joinServiceBtn--inquiry icon_before" data-icon="inquiry">
										<p>お問い合わせ</p>
									</a>
								</li>
								<li><a href="https://faq.starcat.co.jp/?ref=join_apmh" class="joinServiceBtn joinServiceBtn--faq icon_before" data-icon="faq_outline">よくあるご質問</a></li>
							</ul>
						</div>
						<a href="/join/apartment/?ref=join_apmh" class="joinServiceTopLink icon_after" data-icon="arrow_next">集合住宅のお客様TOP</a>
					</div>
				</div>
			</section>

			<!--▽その他のサービス-->
			<section id="other_service" class="joinOtherSection">
				<div class="section_inner">
					<h2 class="joinSectionTitle">その他のサービス</h2>
					<ul class="joinOtherList">
						<li>
							<a href="/service/?ref=join_other" class="joinOtherItem icon_after" data-icon="arrow_next">
								<img src="/img/icon/service_discount_icon.svg" alt="提携・割引サービス">
								<div class="joinOtherItem__body">
									<p class="joinOtherItem__title">提携・割引サービス</p>
									<p class="joinOtherItem__desc">スターキャットのサービスとセットでご利用いただくことでおトクになる各種サービスもご提供中です。</p>
								</div>
							</a>
						</li>
						<li>
							<a href="/service/mvno/?ref=join_other" class="joinOtherItem icon_after" data-icon="arrow_next">
								<img src="/img/icon/service_smartPhone.svg" alt="格安スマホサービス">
								<div class="joinOtherItem__body">
									<p class="joinOtherItem__title">格安スマホサービス</p>
									<p class="joinOtherItem__desc">ご自宅でも店舗でもお申し込みができるスターキャットの格安スマホ「ケーブルスマホ」のご案内です。</p>
								</div>
							</a>
						</li>
						<li>
							<a href="/service/vod/?ref=join_other" class="joinOtherItem icon_after" data-icon="arrow_next">
								<img src="/img/icon/service_video-delivery.svg" alt="動画配信サービス">
								<div class="joinOtherItem__body">
									<p class="joinOtherItem__title">動画配信サービス</p>
									<p class="joinOtherItem__desc">テレビ、スマホ、タブレット、パソコンなどで観たいときに、見たい場所で映画、ドラマ、アニメ、スポーツなどを楽しめるサービスです。</p>
								</div>
							</a>
						</li>
						<li>
							<a href="/service/net/option/security-camera/?ref=join_other" class="joinOtherItem icon_after" data-icon="arrow_next">
								<img src="/img/icon/service_security-camera.svg" alt="防犯カメラサービス">
								<div class="joinOtherItem__body">
									<p class="joinOtherItem__title">防犯カメラサービス</p>
									<p class="joinOtherItem__desc">家庭用防犯カメラなら、24時間あなたの代わりに家を見守り、外出先からスマホで確認できます。<br>見えない不安を“見える安心”に変えて、家族も一人暮らしも、毎日の暮らしをもっと安全に。</p>
								</div>
							</a>
						</li>
						<li>
							<a href="/service/other/?ref=join_other" class="joinOtherItem icon_after" data-icon="arrow_next">
								<img src="/img/icon/service_emergency-report.svg" alt="生活向上サービス">
								<div class="joinOtherItem__body">
									<p class="joinOtherItem__title">生活向上サービス</p>
									<p class="joinOtherItem__desc">もしものときに備えておきたい！お住まいの地域の防災に関する情報をお届けする安心サービスをご用意しています。</p>
								</div>
							</a>
						</li>
					</ul>
				</div>
			</section>
			<!--△202603改修ここまで-->


			<!--▽法人のお客様-->
			<section>
				<div class="section_inner">
					<h6>法人のお客様・マンションオーナー様・管理会社へ</h6>
					<p>オフィスや建物へのご導入はstarcat Bizにおまかせください！</p>
					<div class="cp_banner banner">
						<a href="/business/?ref=join_business" target="_blank">
							<div class="banner_inner">
								<div class="image">
									<img src="/img/business/service01-net_pic.jpg" alt="">
								</div>
								<div class="text">
									<p class="title">法人のお客様向け「starcat Biz」</p>
									<p>スターキャット品質でみなさまのビジネスをサポートします。</p>
								</div>
							</div>
						</a>
					</div>
				</div>
			</section>

			<!--▽お問い合わせセクション-->
			<section>
				<div class="section_inner">
					<div class="join_menu">
						<div class="contact_block flex">
							<a class="apply_btn flex flex_align_center flex_justify_center" href="/mform/?ref=main_content_footer"><span>新規お申し込み</span></a>
							<div class="contact_block_inner">
								<p class="title_border">新規加入に関するお問い合わせ</p>
								<div class="contact_link_list flex flex_justify_center">
									<a class="contact_link_btn form" href="/mform_inquiry/?ref=main_content_footer"><span>フォームから<br>お問い合わせ</span></a>
									<a class="contact_link_btn online" href="https://reserva.be/starcat" target="_blank" rel="noopener noreferrer"><span>オンライン<br>加入相談</span></a>
									<a class="contact_link_btn chat" href="javascript:synalio.toggle(0);"><span>チャットで<br>お問い合わせ</span></a>
									<a id="header_tablet_freecall" class="contact_link_btn tel" href="tel:0120-181-374"><span>お電話で<br>お問い合わせ</span></a>
								</div>
								<div class="tel_contact flex flex_align_center">
									<p>お電話でお問い合わせ</p>
									<div class="freecall">
										<div class="tel">
											<img src="/img/icon/freecall.svg">
											<a href="tel:0120-181-374">0120-181-374</a>
										</div>
										<p>受付時間：日・祝除く9:00～18:00</p>
									</div>
								</div>
							</div>
						</div>
						<div class="menu_block flex">
							<a class="apmh_search flex flex_align_center" href="/service_area/msearch/?ref=main_content_footer">
								<p><span>お住まいの建物の対応状況を確認</span>スターキャット対応マンション・アパート検索</p>
							</a>
							<a class="price_simulation flex flex_align_center" href="/simulation/?ref=main_content_footer">
								<p>料金シミュレーション</p>
							</a>
						</div>
					</div>
				</div>
			</section>

		</div>
		
		<ul class="main_navi">
			<li><a href="/">HOME<img src="/img/icon/link_icon.svg" class="sp"></a></li>
			<li><a href="/service/">スターキャットのサービス<img src="/img/icon/link_icon.svg" class="sp"></a></li>
			<li><a href="/campaign/">キャンペーン<img src="/img/icon/link_icon.svg" class="sp"></a></li>
		</ul>

	<script>
	function switchTab(panel) {
		// パネル切り替え
		document.querySelectorAll('.joinServiceBox').forEach(function (p) {
			p.style.display = 'none';
			p.classList.remove('active');
		});
		panel.style.display = '';
		panel.classList.add('active');

		// タブのactive切り替え
		document.querySelectorAll('.joinHouseTab__btn').forEach(function (b) {
			b.classList.remove('active');
		});
		// クリックされたボタンにactiveを付与
		var btnId = 'tab_' + panel.id.replace('tabpanel_', '');
		document.getElementById(btnId).classList.add('active');
	}
	</script>
    </main>

	<%- include("../layout/_footContentArea") %>
    <%- include("../layout/_footer") %>
</body>
</html>

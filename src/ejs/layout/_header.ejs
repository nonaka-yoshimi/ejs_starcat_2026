						</a>
					</div>
					<div class="dropdownTextLinks">
						<a href="/customer/ss/?ref=navi_usertype" data-icon="arrow_next" class="icon_after">サポート情報</a>
						<a href="/maintenance/?ref=navi_usertype" data-icon="arrow_next" class="icon_after">障害・メンテナンス情報</a>
						<!-- <a href="#" data-icon="arrow_next" class="icon_after">お役立ち情報</a> -->
					</div>
				</div>
				<div class="bannerArea">
					<a href="/customer/starcat-app/?ref=navi_usertype">
						<img src="/img/banner/banner_app-now.jpg" alt="スターキャットアプリ配信中！ダウンロードはこちら">
					</a>
				</div>
			</div>

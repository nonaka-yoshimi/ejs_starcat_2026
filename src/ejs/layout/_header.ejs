
<header>
	<div class="inner">
		<a class="header_logo" href="/?ref=header"><img src="/img/logo/sc_logo_202401.svg" alt="starcatロゴ"></a>
		<div class="showPC commonNav">
			<div data-commonnav="1">
				<button id="joinButton" data-icon="beginner">加入をご検討の方</button>
				<button id="mypageButton" data-icon="mypage">加入者様(サポート・お手続き)</button>
				<a href="/business/?ref=navi_usertype" data-icon="corporation">法人のお客様</a>
			</div>
		</div>
		<div data-commonnav="2">
			<!--▽1201px以上-->
			<div class="showPC01">
				<a href="/service/?ref=gnavi" data-icon="service">サービス一覧</a>
				<a href="/contact/?ref=gnavi" data-icon="inquiry">お問い合わせ</a>
				<a href="https://faq.starcat.co.jp/?ref=gnavi" target="_blank" rel="noopener noreferrer" data-icon="faq">よくあるご質問</a>
				<a href="/company/?ref=gnavi" data-icon="corporate">企業情報</a>
				<form class="searchForm" method="get" action="https://www.google.com/search" target="_blank" rel="noopener noreferrer">
					<label data-icon="search" class="icon_before">
						<input class="search_text" type="text" name="q" placeholder="検索キーワードを入力">
					</label>
					<input type="hidden" name="hl" value="ja">
					<input type="hidden" name="sitesearch" value="www.starcat.co.jp">
				</form>
				<button id="languageButton" data-icon="translation" onclick="toggleOpen(languageList);target(languageButton)">Language</button>
			</div>
			<!--▽1200以下-->
			<a href="/service/?ref=gnavi" data-icon="service" class="showMaxPC showPC">サービス一覧</a>
			<a href="/contact/?ref=gnavi" data-icon="inquiry" class="showMaxPC">お問い合わせ</a>
			<a href="https://faq.starcat.co.jp/?ref=gnavi" target="_blank" rel="noopener noreferrer" data-icon="faq" class="showMaxPC">よくあるご質問</a>
			<a href="/company/?ref=gnavi" data-icon="corporate" class="showMaxPC showPC">企業情報</a>
			<button id="searchButton" data-icon="search" onclick="toggleOpen(headerSearchArea);target(searchButton)" class="showMaxPC">検索</button>
			<button id="languageButton" data-icon="translation" onclick="toggleOpen(languageList);target(languageButton)" class="showMaxPC showPC">Language</button>
			<button class="headerMenuButton showTB" onclick="modalOpen(navMenuArea)">
				<div>
					<span></span>
					<span></span>
					<span></span>
				</div>
			</button>
		</div>
	</div>
	<ul id="languageList">
		<li><a href="/?ref=lang" class="cl-norewrite">日本語</a></li>
		<li><a href="https://www.starcat.co.jp.e.lh.hp.transer.com/?ref=lang">English</a></li>
		<li><a href="https://www.starcat.co.jp.c.lh.hp.transer.com/?ref=lang">中文（簡体字）</a></li>
		<li><a href="https://www.starcat.co.jp.t.lh.hp.transer.com/?ref=lang">中文（繁体字）</a></li>
		<li><a href="https://www.starcat.co.jp.k.lh.hp.transer.com/?ref=lang">한국어</a></li>
		<li><a href="https://www.starcat.co.jp.p.lh.hp.transer.com/?ref=lang">Português</a></li>
	</ul>
	<div id="headerSearchArea" class="searchArea showMaxPC">
		<form class="searchForm" method="get" action="https://www.google.com/search" target="_blank" rel="noopener noreferrer">
			<label data-icon="search" class="icon_before">
				<input class="search_text" type="text" name="q" placeholder="検索キーワードを入力">
			</label>
			<input type="hidden" name="hl" value="ja">
			<input type="hidden" name="sitesearch" value="www.starcat.co.jp">
		</form>
	</div>
	<!--▽加入をご検討の方モーダル-->
	<div id="menuJoinArea" class="modalArea">
		<div class="modalContents">
			<div class="inner">
				<button onclick="modalClose(menuJoinArea)" data-icon="close"></button>
				<a href="/join/?ref=navi_usertype" class="dropdownTopLink icon_after" data-icon="arrow_next">加入をご検討の方TOP</a>
				<div class="dropdownButtonGrid dropdownButtonGrid--join">
					<a href="/join/house/?ref=navi_usertype" class="dropdownBtn dropdownBtn--green dropdownBtn--large">
						<img src="/img/icon/kodate_icon.svg" alt="戸建住宅アイコン">
						<p>戸建住宅の<br class="showTB">お客様</p>
					</a>
					<a href="/join/apartment/?ref=navi_usertype" class="dropdownBtn dropdownBtn--green dropdownBtn--large">
						<img src="/img/icon/apmh_icon.svg" alt="集合住宅アイコン">
						<p>集合住宅の<br class="showTB">お客様</p>
					</a>
					<a href="/simulation/?ref=navi_usertype" class="dropdownBtn dropdownBtn--green">
						<img src="/img/icon/price_simulation_icon.svg" alt="料金シミュレーションアイコン">
						<p>料金シミュレーション</p>
					</a>
					<a href="/campaign/?ref=navi_usertype" class="dropdownBtn dropdownBtn--green">
						<img src="/img/icon/campaign_w_icon.svg" alt="キャンペーンアイコン">
						<p>キャンペーン・特典</p>
					</a>
					<a href="/service_area/?ref=navi_usertype" class="dropdownBtn dropdownBtn--green">
						<img src="/img/icon/servicearea_white_icon.svg" alt="エリアアイコン">
						<p>サービス提供エリア</p>
					</a>
				</div>
				<ul class="dropdownBottomLinks">
					<li><a href="/mform/?ref=navi_usertype" data-icon="entry" class="icon_before">新規加入<br class="showTB">お申し込み</a></li>
					<li><a href="/contact/?ref=navi_usertype#_link_1" data-icon="inquiry" class="icon_before">お問い合わせ</a></li>
					<li><a href="https://faq.starcat.co.jp/?ref=navi_usertype" target="_blank" rel="noopener noreferrer" data-icon="faq_outline" class="icon_before">よくある<br class="showTB">ご質問</a></li>
				</ul>
			</div>
		</div>
	</div>
	<!--▽加入者様(サポート・お手続き)モーダル-->
	<div id="menuCustomerArea" class="modalArea">
		<div class="modalContents">
			<div class="inner">
				<button onclick="modalClose(menuCustomerArea)" data-icon="close"></button>
				<a href="/customer/?ref=navi_usertype" class="dropdownTopLink icon_after" data-icon="arrow_next">お客様サポートTOP</a>
				<div class="dropdownButtonGrid dropdownButtonGrid--customer">
					<a href="/contact/?ref=navi_usertype#_link_2" class="dropdownBtn dropdownBtn--orange dropdownBtn--large">
						<img src="/img/icon/inquiry_icon.png" alt="お問い合わせアイコン">
						<p>お問い合わせ</p>
					</a>
					<a href="https://faq.starcat.co.jp/?ref=navi_usertype" target="_blank" rel="noopener noreferrer" class="dropdownBtn dropdownBtn--orange dropdownBtn--large">
						<img src="/img/icon/faq_o_icon.svg" alt="よくある質問（FAQ）">
						<p>よくあるご質問</p>
					</a>
					<a href="/customer/self/mypage/?ref=navi_usertype" class="dropdownBtn dropdownBtn--orange">
						<img src="/img/icon/user.svg" alt="マイページアイコン">
						<p>マイページ</p>
					</a>
					<a href="/customer/self/webmail/?ref=navi_usertype" class="dropdownBtn dropdownBtn--orange">
						<img src="/img/icon/webmail.svg" alt="Webメールアイコン">
						<p>Webメール</p>
					</a>
					<a href="/customer/action/?ref=navi_usertype" class="dropdownBtn dropdownBtn--orange">
						<img src="/img/icon/procedure_icon.png" alt="各種お手続きアイコン">
						<p>各種お手続き</p>
					</a>
					<a href="/customer/self/tel/?ref=navi_usertype" class="dropdownBtn dropdownBtn--orange">
						<img src="/img/icon/tel_config.png" alt="電話 各種設定アイコン">
